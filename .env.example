# TrendingRepo - sample env. Copy to `.env.local` for development.
# Production env lives in Vercel project settings; mirror the same vars.
#
# NOTE: STARSCREENER_* env vars are still accepted as aliases for one release.
# Boot logs will warn when an old name is used. Migrate to TRENDINGREPO_* before next major.

# -- GitHub auth --------------------------------------------------------------
# Single PAT (back-compat). The in-process pipeline reads this through the
# token pool - see src/lib/github-token-pool.ts. Required for production.
# Scopes: public_repo (read), no write scopes.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Additional PATs, comma-separated. The pool round-robins across all
# configured tokens and tracks per-token rate-limit. Adding tokens here
# linearly increases ingest throughput (each PAT = +5,000 requests/hr).
# Example with three additional tokens:
#   GH_TOKEN_POOL=ghp_aaa...,ghp_bbb...,ghp_ccc...
#
# IMPORTANT: GitHub Actions reserves the "GITHUB_*" secret prefix -
# secrets MUST be named GH_TOKEN_POOL (not GITHUB_TOKEN_POOL) when set
# via `gh secret set`. The pool reads BOTH names so a half-migrated env
# keeps working; prefer GH_TOKEN_POOL for new setups.
GH_TOKEN_POOL=
GITHUB_TOKEN_POOL=  # alias - kept for back-compat with older .env files

# -- Cron protection ----------------------------------------------------------
# 16+ char shared secret used by /api/cron/* and the GitHub Actions workflows
# that hit those routes. Required for production.
CRON_SECRET=

# Browser-facing admin APIs require a dedicated token (do NOT reuse
# CRON_SECRET). verifyAdminAuth returns 503 when this is missing.
ADMIN_TOKEN=
# Optional comma-separated denylist for known scraper IPs on admin APIs.
# Uses forwarded client IP at Vercel/Cloudflare edge.
# ADMIN_IP_BLOCKLIST=203.0.113.11,198.51.100.42
# Admin cookie-login path (/api/admin/login) requires all four:
# ADMIN_USERNAME, ADMIN_PASSWORD, ADMIN_TOTP_SECRET, SESSION_SECRET.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Base32-encoded TOTP seed for admin MFA (6-digit authenticator codes).
ADMIN_TOTP_SECRET=
# Shared HMAC secret for signed ss_user / ss_admin cookies.
SESSION_SECRET=

# Internal agent auth map used by verifyInternalAgentAuth().
# JSON object shape:
# INTERNAL_AGENT_TOKENS_JSON={"agent-name":"token-value"}
# Graceful rotation shape (new + old overlap):
# INTERNAL_AGENT_TOKENS_JSON={"agent-name":["new-token","old-token"]}
INTERNAL_AGENT_TOKENS_JSON=

# -- Persistence (Redis) ------------------------------------------------------
# Pick ONE of the two - never set both.
#
# Railway / standard Redis (TCP). ioredis backend.
# REDIS_URL=rediss://default:password@host.proxy.rlwy.net:port
#
# Upstash (REST). Legacy compatibility; Railway is preferred for cost.
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# -- Optional: revenue enrichment (CI scripts only) --------------------------
# TRUSTMRR_API_KEY=

# -- Optional: weekly digest (Resend) ----------------------------------------
# DIGEST_ENABLED=false
# RESEND_API_KEY=
# EMAIL_FROM="TrendingRepo Digest <digest@your-domain.com>"
# DIGEST_USER_EMAILS_JSON={"user-id":"user@example.com"}

# -- Optional: future auth ---------------------------------------------------
# DATABASE_URL=
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3023

# -- Override flags ----------------------------------------------------------
# Allow the mock GitHub adapter (local dev only). Hard-disabled in prod.
# TRENDINGREPO_ALLOW_MOCK=true
# Allow boot without GITHUB_TOKEN / CRON_SECRET in production (preview only).
# TRENDINGREPO_ALLOW_MISSING_ENV=true

# -- AISO scan protocol (pluggable; defaults target aiso.tools) -------------
# Set to false to disable auto-scan calls.
# TRENDINGREPO_AISO_AUTO_SCAN=true
#
# Optional base URL override for the scan backend:
# AISO_API_URL=https://aiso.tools
# AISO_TOOLS_API_URL=https://aiso.tools   # alias
# AISOTOOLS_API_URL=https://aiso.tools    # alias
#
# Optional protocol/path overrides for non-aiso.tools providers.
# Keep defaults for aiso.tools:
# AISO_SCAN_PROTOCOL=aiso.tools
# AISO_SCAN_SUBMIT_PATH=/api/scan
# AISO_SCAN_STATUS_PATH_TEMPLATE=/api/scan/{scanId}
# AISO_SCAN_RESULT_PATH_TEMPLATE=/scan/{scanId}

# -- PostHog (web analytics + product analytics) -----------------------------
# Same project key as AISO + AGNT - one PostHog org, three surfaces, person
# profiles merge across properties when distinct_id matches Supabase user.id.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# -- Sentry (errors + source maps + scrape-script alarms) --------------------
# Create project at https://sentry.io/organizations/<org>/projects/new/
# (pick "Next.js"). DSN powers both the Next app AND scripts/_logger.mjs
# (cron scrapers). Same DSN in both NEXT_PUBLIC_SENTRY_DSN (browser) and
# SENTRY_DSN (server + scrape scripts). Auth token gates source-map upload.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=trendingrepo

# -- Optional: platform ops alerts -------------------------------------------
# Fatal platform paths (for example full Twitter source failure, GitHub pool
# exhaustion) can post a best-effort JSON alert here.
# Must be an HTTPS URL (localhost/non-HTTPS values are rejected).
# OPS_ALERT_WEBHOOK=https://hooks.slack.com/services/...

# Weekly subdomain takeover scanner targets (cron-subdomain-takeover.yml).
# JSON array shape:
#   [{"host":"api.starscreener.com","expectedProvider":"vercel"}]
# Empty/unset blocks the scan route by design (returns 503).
SUBDOMAIN_TAKEOVER_TARGETS_JSON=

# -- Optional: Cloudflare Turnstile (anonymous submission protection) --------
# Required to protect public submission endpoints from bot floods:
#   - /api/repo-submissions
#   - /api/submissions/revenue
# Get keys at https://dash.cloudflare.com/ -> Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -- Optional: Portal CORS allow-list ----------------------------------------
# Comma-separated HTTP(S) origins allowed for /portal and /portal/call browser access.
# If unset, defaults include local dev origins and configured public site URL.
# PORTAL_CORS_ALLOWED_ORIGINS=https://trendingrepo.com,https://www.trendingrepo.com
