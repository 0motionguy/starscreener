# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime data (kept ignored except production Twitter signal snapshots)
/.data/*
!/.data/
!/.data/twitter-repo-signals.jsonl
!/.data/twitter-scans.jsonl
!/.data/twitter-ingestion-audit.jsonl
!/.data/trending-dual-write-trace.jsonl
!/.data/aiso-rescan-queue.jsonl
!/.data/mcp-usage.jsonl
# SECURITY: never commit the outbound X OAuth2 state — it holds live rotated
# refresh tokens. Already covered by `/.data/*`, but this explicit ignore
# (placed AFTER the whitelist, so it wins) guarantees a future broad
# `!/.data/*.jsonl` allow-rule can't ever expose it.
/.data/twitter-oauth-state.jsonl

# runtime data-store file mirror (Redis is source of truth; written at listing time)
/data/recent-drops.json

# local Claude Code workspace (agent prompts, skills, settings)
/.claude/

# impeccable skill bundle (installed via `npx impeccable skills install`)
/.agents/
/skills/
/skills-lock.json

# mcp workspace build artifacts + installed deps
/mcp/node_modules/
/mcp/dist/
.next-dev-*.log
.next-dev-debug.*.log


# local dev logs (next start -p <port> redirects)
.next-start-*.log
.next-start-*.out.log
.next-start-*.err.log
/.dev-clean-*.log

# dogfood script output
dogfood-output/

# playwright-mcp local capture / trace output
.playwright-mcp/

# playwright e2e — install reports, traces, screenshots
/playwright-report/
/test-results/
/blob-report/
/.cache/playwright/

# local build / typecheck logs
build_*.log
build-*.log
typecheck_*.log
dev_server*.log

# scratch probe directories from local debug sessions
tmp_probe/
.tmp/
/.tmp-screenshots/

# personal operator rules (per CLAUDE.md — not for commit)
CLAUDE.local.md

# embedded clones (not submodules)
awesome-codex-skills/

# agent scratch directories — never commit, even by accident
.audit/
.claude-flow/
.hive-mind/
.tmp-*.log

# storybook static build output (built artifact, not source)
/storybook-static/

# operator scratch — non-dot-prefixed shapes (existing .tmp_* / .tmp-* patterns miss these)
/tmp_*.json
/tmp-*.log
/tmp-*.err.log
/tmp-*.out.log

# QA freshness probe run dumps
/qa-freshness-*.json

# Stryker mutation HTML reports (config stays committed)
/reports/

# generated Storybook static output rendered into docs
/docs/storybook/

# local agent vector DB (per-machine runtime state, regenerated automatically)
/ruvector.db

# perf audit output (Lighthouse-via-PSI, etc.)
/.perf/

# clerk configuration (can include secrets)
/.clerk/
.tier-staging/

# Operator-local scratch artifacts (screenshots, audit dumps, debug HTML)
# Added 2026-05-27 to clean up the 8+ untracked artifacts accumulating at
# the repo root.
/._*
/.audit-*.html
/.audit-*.json
/.echarts-themes/
/.specify/
/.verify-auth/
/_tmp_*.html
/_tmp_*.json
/_tmp_*.mts
/tmp_*.mts
/trending-repos-ios-gallery.html
/trending-repos-ios-gallery.html.artifact.json
# Typo'd Windows-path-as-filename artifact (the path-resolver wrote literal
# `Usersmirko...` instead of `C:\Users\mirko\...`); ignore by prefix.
/Usersmirko*

