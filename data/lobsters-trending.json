    {
      "shortId": "29pm2f",
      "title": "LLM generated submissions should be disallowed",
      "url": "",
      "commentsUrl": "https://lobste.rs/s/29pm2f/llm_generated_submissions_should_be",
      "by": "",
      "score": 98,
      "commentCount": 24,
      "createdUtc": 1778873667,
      "ageHours": 3.950277777777778,
      "trendingScore": 6.751810039635503,
      "tags": [
        "meta",
        "philosophy"
      ],
      "description": "<p>There's a lot of talk about what to do if an LLM generated article gets posted. I don't believe that there's a clear policy about whether they should be allowed.</p>\n<p>I think users posting them regularly should be banned from the site.</p>\n<p>A notification on the submission page reminding people that LLM generated articles are not allowed here would also be a good idea.</p>\n<p>This should reduce the amount of debate on whether the article should be flagged or commented on.</p>\n",
      "linkedRepos": []
    },
