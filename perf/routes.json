{
  "$schema": "./routes.schema.json",
  "version": 1,
  "_doc": "Single source of truth for public-route cache policy + perf budgets. Every src/app/**/page.tsx not under admin|api|alerts|sign-in|sign-up|submit|embed|design-lab|portal|watchlist|you|refer|brief|s should appear here, or be ignored via perf/.perfignore. Used by scripts/perf-routes.mjs (cache+TTFB+transfer asserter), scripts/perf-bundle.mjs (route JS budget + forbidden-import detector), scripts/check-routes-config.mjs (completeness lint), and .github/workflows/cron-warmup.yml (warmup matrix). MAJORLY TRIMMED 2026-05-19 after UI v4 archive — only the home placeholder + /api/health probe survive. Routes will be re-added as the rebuild lands new pages.",
  "globalDefaults": {
    "ttfbBudgetMs": { "cached": 800, "uncached": 1500 },
    "transferBudgetKb": 90,
    "firstLoadJsBudgetKb": 400
  },
  "routes": [
    {
      "route": "/",
      "policy": "isr",
      "revalidateSeconds": 1800,
      "ttfbBudgetMs": { "cached": 600, "uncached": 1500 },
      "transferBudgetKb": 130,
      "firstLoadJsBudgetKb": 650,
      "warmupOnDeploy": true,
      "warmupCadence": "*/5 8-21 * * *",
      "owner": "home"
    },
    {
      "route": "/breakout",
      "policy": "isr",
      "revalidateSeconds": 1800,
      "ttfbBudgetMs": { "cached": 700, "uncached": 1500 },
      "transferBudgetKb": 120,
      "firstLoadJsBudgetKb": 550,
      "warmupOnDeploy": true,
      "warmupCadence": "*/10 8-21 * * *",
      "owner": "breakout"
    },
    {
      "route": "/preview",
      "policy": "isr",
      "revalidateSeconds": 3600,
      "ttfbBudgetMs": { "cached": 600, "uncached": 1500 },
      "transferBudgetKb": 110,
      "firstLoadJsBudgetKb": 500,
      "warmupOnDeploy": false,
      "owner": "preview"
    },
    {
      "route": "/market-signals",
      "policy": "isr",
      "revalidateSeconds": 1800,
      "ttfbBudgetMs": { "cached": 800, "uncached": 1600 },
      "transferBudgetKb": 140,
      "firstLoadJsBudgetKb": 600,
      "warmupOnDeploy": true,
      "warmupCadence": "*/10 8-21 * * *",
      "owner": "market-signals"
    },
    {
      "route": "/funding",
      "policy": "isr",
      "revalidateSeconds": 1800,
      "ttfbBudgetMs": { "cached": 800, "uncached": 1600 },
      "transferBudgetKb": 140,
      "firstLoadJsBudgetKb": 600,
      "warmupOnDeploy": true,
      "warmupCadence": "*/10 8-21 * * *",
      "owner": "funding"
    },
    {
      "route": "/revenue",
      "policy": "isr",
      "revalidateSeconds": 1800,
      "ttfbBudgetMs": { "cached": 800, "uncached": 1600 },
      "transferBudgetKb": 140,
      "firstLoadJsBudgetKb": 600,
      "warmupOnDeploy": true,
      "warmupCadence": "*/10 8-21 * * *",
      "owner": "revenue"
    },
    {
      "route": "/agent-commerce",
      "policy": "isr",
      "revalidateSeconds": 1800,
      "ttfbBudgetMs": { "cached": 800, "uncached": 1600 },
      "transferBudgetKb": 140,
      "firstLoadJsBudgetKb": 600,
      "warmupOnDeploy": true,
      "warmupCadence": "*/10 8-21 * * *",
      "owner": "agent-commerce"
    },
    {
      "route": "/tools",
      "policy": "isr",
      "revalidateSeconds": 600,
      "ttfbBudgetMs": { "cached": 800, "uncached": 1600 },
      "transferBudgetKb": 140,
      "firstLoadJsBudgetKb": 600,
      "warmupOnDeploy": true,
      "warmupCadence": "*/10 8-21 * * *",
      "owner": "tools"
    },
    {
      "route": "/api/health?soft=1",
      "policy": "dynamic-public",
      "expectsDynamic": true,
      "reason": "health probe reflects live state through a short shared cache; cron-freshness-check polls this every 15 min",
      "ttfbBudgetMs": { "cached": 400, "uncached": 600 },
      "transferBudgetKb": 5,
      "warmupOnDeploy": true
    },
    {
      "route": "/repo/[owner]/[name]",
      "policy": "dynamic-public",
      "expectsDynamic": true,
      "reason": "per-repo profile — `export const dynamic = 'force-dynamic'` so per-repo data isn't pinned to ISR; unbounded slug space",
      "ttfbBudgetMs": { "cached": 800, "uncached": 1800 },
      "transferBudgetKb": 140,
      "firstLoadJsBudgetKb": 600,
      "warmupOnDeploy": false,
      "owner": "repo-detail"
    },
    {
      "route": "/build",
      "policy": "dynamic-private",
      "expectsDynamic": true,
      "reason": "Clerk-gated build workflow dashboard — per-user repo + draft state, anon redirects to /sign-in",
      "ttfbBudgetMs": { "cached": 800, "uncached": 1800 },
      "transferBudgetKb": 140,
      "firstLoadJsBudgetKb": 600,
      "warmupOnDeploy": false,
      "owner": "build"
    },
    {
      "route": "/account",
      "policy": "dynamic-private",
      "expectsDynamic": true,
      "reason": "Clerk-gated account dashboard - per-user profile, watchlist, alerts, API keys, drops, referrals, and timeline; anon redirects to /sign-in",
      "ttfbBudgetMs": { "cached": 800, "uncached": 1800 },
      "transferBudgetKb": 140,
      "firstLoadJsBudgetKb": 600,
      "warmupOnDeploy": false,
      "owner": "account"
    },
    {
      "route": "/ideas",
      "policy": "isr",
      "revalidateSeconds": 600,
      "ttfbBudgetMs": { "cached": 800, "uncached": 1600 },
      "transferBudgetKb": 140,
      "firstLoadJsBudgetKb": 600,
      "warmupOnDeploy": true,
      "warmupCadence": "*/10 8-21 * * *",
      "owner": "ideas"
    },
    {
      "route": "/ideas/[id]",
      "policy": "dynamic-public",
      "expectsDynamic": true,
      "reason": "per-idea workspace — `export const dynamic = 'force-dynamic'` because per-id reactions + contributions vary; unbounded slug space",
      "ttfbBudgetMs": { "cached": 800, "uncached": 1800 },
      "transferBudgetKb": 140,
      "firstLoadJsBudgetKb": 600,
      "warmupOnDeploy": false,
      "owner": "ideas"
    },
    {
      "route": "/drop",
      "policy": "dynamic-public",
      "expectsDynamic": true,
      "reason": "4-step submission funnel — `export const dynamic = 'force-dynamic'`. Per-IP rate-limit on POST + per-user queue state when signed in; URL-state survives reload via localStorage draft.",
      "ttfbBudgetMs": { "cached": 800, "uncached": 1800 },
      "transferBudgetKb": 130,
      "firstLoadJsBudgetKb": 600,
      "warmupOnDeploy": false,
      "owner": "drop"
    }
  ]
}
