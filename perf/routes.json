{
  "$schema": "./routes.schema.json",
  "version": 1,
  "_doc": "Single source of truth for public-route cache policy + perf budgets. Every src/app/**/page.tsx not under admin|api|alerts|sign-in|sign-up|submit|embed|design-lab|portal|watchlist|you|refer|brief|s should appear here, or be ignored via perf/.perfignore. Used by scripts/perf-routes.mjs (cache+TTFB+transfer asserter), scripts/perf-bundle.mjs (route JS budget + forbidden-import detector), scripts/check-routes-config.mjs (completeness lint), and .github/workflows/cron-warmup.yml (warmup matrix).",
  "globalDefaults": {
    "ttfbBudgetMs": { "cached": 800, "uncached": 1500 },
    "transferBudgetKb": 90,
    "firstLoadJsBudgetKb": 400
  },
  "routes": [
    {
      "route": "/",
      "policy": "isr",
      "revalidateSeconds": 1800,
      "ttfbBudgetMs": { "cached": 600, "uncached": 1500 },
      "transferBudgetKb": 130,
      "firstLoadJsBudgetKb": 650,
      "warmupOnDeploy": true,
      "warmupCadence": "*/5 8-21 * * *",
      "owner": "home"
    },
    {
